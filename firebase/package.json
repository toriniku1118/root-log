{
  "name": "rootlog-firebase",
  "private": true,
  "version": "0.1.0",
  "description": "RootLog のセキュリティルールと自動テスト",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project rootlog-rules-test \"vitest run\"",
    "test:watch": "firebase emulators:exec --only firestore,storage --project rootlog-rules-test \"vitest\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
